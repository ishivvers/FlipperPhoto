function rphot_new_image,imname,mjd,efftime
COMPILE_OPT IDL2

;; creates a new structure to hold image data. Tries to find the cobj
;; file associated with the imname.

if keyword_set(imname) then begin
    ;; find the cobjfile
    dir=strmid(imname,0,strpos(imname,'/',/REVERSE_SEARCH)-5)+'prod/'
    file=strmid(imname,strpos(imname,'/',/REVERSE_SEARCH)+1)
    file=strmid(file,0,strpos(file,'.fit'))+'obj.fit'
    cobjfile=dir+file
endif else cobjfile=''

temp = {                        $
         imname: imname,        $
         timestamp: 0.0d,       $
         image: ptr_new(0),     $
         cobjfile: cobjfile,    $
         sumind: 0L,            $
         mjd: 0.0d,             $
         exp: 0.0d,             $
         nx: 0L,                $
         ny: 0L,                $
         clip: [0,0,0,0],       $
         zoom: [0,0,0,0],       $
         skymode: 0.0d,         $
         skysig: 0.0d,          $
         span: 0.0d,            $
         zero: 0.0d,            $
         kx: ptr_new(-1),       $
         ky: ptr_new(-1),       $
         x: -1.0d,              $
         y: -1.0d,              $
         ra: -1.0d,             $
         dec: -1.0d,            $
         counts: !values.d_nan, $
         ecounts: !values.d_nan,$
         sky: !values.d_nan,    $
         skynoise: !values.d_nan,$
         rad: 3.5d,             $
         refx: ptr_new(-1),     $
         refy: ptr_new(-1),     $
         refra: ptr_new(-1),    $
         refdec: ptr_new(-1),   $
         refcounts: ptr_new(!values.d_nan),$
         refecounts: ptr_new(!values.d_nan),$
         objx: ptr_new(-1),     $
         objy: ptr_new(-1),     $
         objra: ptr_new(-1),    $
         objdec: ptr_new(-1),   $
         ratio: 1.0d,           $
         eratio: 0.0d,          $
         psf: ptr_new(0),       $
         mask: ptr_new(-1)      $
       }

return,temp

end

;; ********************************************************************************
function rphot_copy_image,oldimage
COMPILE_OPT IDL2

;; returns a new image structure with all the fields coppied over from
;; oldimage (new pointers, same old data).

image=rphot_new_image(oldimage.imname,oldimage.mjd,oldimage.exp)

n_tags=n_tags(image)
for i=0,n_tags-1 do begin
    info=size( image.(i) )
    type=info[n_elements(info)-2]
    if type eq 10 then *image.(i)=*oldimage.(i) $
    else image.(i)=oldimage.(i)
endfor

return,image

end

