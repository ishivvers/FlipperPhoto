rphot_display_image,data
rphot_display_plot,data
rphot_display_closeup,data

end

;; ********************************************************************************
pro rphot_get_counts,event
COMPILE_OPT IDL2

;; recalculate photometry for the current image

widget_control,event.top,get_uvalue=data
ims=(*(*data).images)[(*data).current_image]
refims=(*(*data).images)[(*data).refi]

;; get the psf
rphot_get_psf,data,ims

;; do photometry on refstars
rphot_get_object_counts,data,*ims.refx,*ims.refy,flux,eflux
*ims.refcounts=flux
*ims.refecounts=eflux

;; get the ratio ref/new counts
ratios=flux/(*refims.refcounts)
eratios=sqrt( (eflux/(*refims.refcounts))^2.0 + ((*refims.refecounts)*flux/(*refims.refcounts)^2.0)^2.0 )
ratio=wtaverage(ratios,eratios)
ims.ratio=ratio[0]
ims.eratio=ratio[1]

;; do photometry on target
rphot_get_object_counts,data,ims.x,ims.y,flux,eflux,lsky=lsky,skynoise=skynoise
ims.counts=flux
ims.ecounts=eflux
ims.sky=lsky
ims.skynoise=skynoise

;; record
(*(*data).images)[(*data).current_image]=ims

;; redraw
rphot_display_image,data
rphot_display_plot,data

end

;; ********************************************************************************
pro rphot_get_object_counts,data,x,y,flux,eflux,lsky=lsky,std=std,skynoise=skynoise
COMPILE_OPT IDL2

;; preforms aperature photometry on the current image. X and Y can be
;; arrays. If no mask exists for the current image and we are getting
;; target counts, transforms the refimage sky mask to the current
;; image, then checks for additional bad pixels (CRs, etc.). Otherwise
;; masks are calculated on the fly.

ims=(*(*data).images)[(*data).current_image]

n=n_elements(x)
flux=dblarr(n)
eflux=dblarr(n)
for i=0,n-1 do begin
    ;; is this the target?
    if x[i] eq ims.x and y[i] eq ims.y then begin
        ;; does a mask exist?
        if (*ims.mask)[0] eq -1 then begin
            if (*data).current_image eq (*data).refi then begin
                undefine,inmask
                noreject=0
            endif else begin
                ;; make one
                refims=(*(*data).images)[(*data).refi]
                refmask=*refims.mask
                refx=refmask mod ims.nx
                refy=refmask/ims.nx

                ;; dilate the mask by 0.2 pix
                refx=[refx-0.2,refx,refx+0.2 $
                      ,refx-0.2,refx,refx+0.2 $
                      ,refx-0.2,refx,refx+0.2 ]
                refy=[refy-0.2,refy-0.2,refy-0.2 $
                      ,refy,refy,refy $
                      ,refy+0.2,refy+0.2,refy+0.2]

                ;; transform the mask
                kmap,refx,refy,newx,newy,*ims.kx,*ims.ky
                inmask=long(round(newx)+round(newy)*ims.nx)
                inmask=inmask[uniq(inmask,sort(inmask))]
                noreject=0
            endelse
        endif else begin
            inmask=*ims.mask
            noreject=1
        endelse
    endif else begin
        undefine,inmask
        noreject=0
    endelse
 
    ;; do local sky subtraction
    lsky=(get_local_sky(*ims.image,x[i],y[i],ims.rad+1.0,3.0*ims.rad $
                        ,annulus=annulus,std=std,rej=rej,inmask=inmask,noreject=noreject))[0]
    npix=n_elements(annulus)
    w=where(noreject ne -1,nrej)
    if noreject eq 0 then npix=npix-nrej
    setsky=[lsky,std,npix]

    ;; save target mask
    if x[i] eq ims.x and y[i] eq ims.y and (*ims.mask)[0] eq -1 then begin
        ;; save the mask
        if (*data).current_image eq (*data).refi then *ims.mask=rej $
        else if rej[0] ne -1 then *ims.mask=[inmask,rej] $
        else *ims.mask=inmask
        w=where(*ims.mask ne -1,nw)
        if nw gt 0 then *ims.mask=(*ims.mask)[w]

        ;; record
        (*(*data).images)[(*data).current_image]=ims
    endif

    ;; ##### replace masked pixels inside the aper radius with profile
    ;; values #####

    ;; get the counts
    aper,*ims.image,x[i],y[i],f,ef,sky,esky,1,ims.rad,[ims.rad+1.0,3.0*ims.rad],[0,0] $
        ,/flux,/exact,/silent,setskyval=setsky
    flux[i]=f
    eflux[i]=ef

    ;; calcualte the local sky noise
    area=!pi*ims.rad^2.0
    skynoise=sqrt(area*std^2.0 + std^2.0/npix*area^2.0)
endfor

w=where(finite(flux) eq 0,nw)
if nw gt 0 then begin
    print,"APER returned flux=NAN. It shouldn't. Use updated APER...stopping"
    stop
endif

end

