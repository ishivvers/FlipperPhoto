;; ********************************************************************************
pro rphot_done,event
COMPILE_OPT IDL2

;; shuts down rphot helper widgets when the user clicks "done"

widget_control,event.top,get_uvalue=data

;; blank the widget id
widget_control,event.id,get_uvalue=type
case type of
    'select_objects': begin
        ;; erase all data using old target
        for i=0,n_elements( (*(*data).images).imname)-1 do begin
            if (*(*data).images)[i].imname ne (*(*data).images)[(*data).refi].imname then begin
                (*(*data).images)[i].ratio=1.0
                (*(*data).images)[i].eratio=0.0
                (*(*data).images)[i].ra=-1.0
                (*(*data).images)[i].dec=-1.0
                (*(*data).images)[i].x=-1.0
                (*(*data).images)[i].y=-1.0
                *(*(*data).images)[i].refra=-1.0
                *(*(*data).images)[i].refdec=-1.0
                *(*(*data).images)[i].refx=-1.0
                *(*(*data).images)[i].refy=-1.0
                *(*(*data).images)[i].refcounts=!values.d_nan
                *(*(*data).images)[i].refecounts=!values.d_nan
                *(*(*data).images)[i].mask=-1
            endif
        endfor

        ;; do photometry
        refims=(*(*data).images)[(*data).refi]
        if (*data).just_one eq 0 then begin
            ;; get the psf
            rphot_get_psf,data,refims
            
            ;; do photometry on refstars
            rphot_get_object_counts,data,*refims.refx,*refims.refy,flux,eflux
            *refims.refcounts=flux
            *refims.refecounts=eflux
        endif

        ;; do photometry on target
        rphot_get_object_counts,data,refims.x,refims.y,flux,eflux,lsky=lsky,skynoise=skynoise
        refims.counts=flux
        refims.ecounts=eflux
        refims.sky=lsky
        refims.skynoise=skynoise
        (*(*data).images)[(*data).refi]=refims

        ;; clear select mode
        (*data).select_objects_id=0
        (*data).mode='zoom'
    end
    'cancel_select': begin
        (*data).select_objects_id=0
        (*data).mode='zoom'
    end
    'show_image': (*data).show_image_id=0
    else:
endcase

;; good-bye
widget_control,event.top,/destroy

end

